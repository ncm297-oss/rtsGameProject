  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"== Studio dashboard: first 40 lines of studio/STATE.md ==\"; head -n 40 \"$CLAUDE_PROJECT_DIR/studio/STATE.md\" 2>/dev/null; echo \"== Git: $(git -C \"$CLAUDE_PROJECT_DIR\" status -sb 2>/dev/null | head -n 1) (run git pull if behind) ==\"; true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
